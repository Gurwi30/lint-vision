
<idea-plugin>
    <resource-bundle>messages.LintVisionBundle</resource-bundle>
    <id>dev.gurwi.LintVision</id>
    <name>LintVision</name>
    <vendor url="https://www.gurwi.dev">Gurwi</vendor>
    <description>
        <![CDATA[
        <html>
            <body>
                <p>Shows errors, warnings and other inspection messages inline at the end of the line, like the VS Code Error Lens extension.</p>
                <p>Fully customizable under <em>Settings | Tools | LintVision</em>.</p>
            </body>
        </html>
        ]]>
    </description>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>
    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="dev.gurwi.lintvision.LintVision"/>
        <applicationService serviceImplementation="dev.gurwi.lintvision.settings.LintVisionSettings"/>
        <applicationConfigurable
                parentId="tools"
                instance="dev.gurwi.lintvision.settings.LintVisionConfigurable"
                id="dev.gurwi.lintvision.settings"
                key="settings.displayName"/>
    </extensions>
    <actions>
        <action
                id="LintVision.Toggle"
                class="dev.gurwi.lintvision.action.ToggleLintVisionAction"
                text="Action.Toggle.Text"
                description="Action.toggle.description">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
